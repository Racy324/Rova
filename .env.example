ROVA_PROVIDER=openai_compatible
ROVA_MODEL=your-model-id
ROVA_PROVIDER_TIMEOUT=60
ROVA_PROVIDER_MAX_RETRIES=2
ROVA_TERMINAL_BACKEND=
ROVA_DOCKER_IMAGE=
# Optional explicit MCP server configuration; MCP is disabled when omitted.
# ROVA_MCP_CONFIG=./mcp.toml
ROVA_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key
# Optional Experience Review controls (enabled by default).
# ROVA_EXPERIENCE_REVIEW_ENABLED=true
# ROVA_EXPERIENCE_REVIEW_TOOL_THRESHOLD=10
# ROVA_EXPERIENCE_REVIEW_TASK_THRESHOLD=5
# Optional auxiliary Vision tool (enabled only with --workspace and these credentials).
# ROVA_VISION_MODEL=qwen3-vl-flash
# ROVA_VISION_BASE_URL=https://your-vision-provider.example/v1
# ROVA_VISION_API_KEY=your-vision-api-key
# ROVA_VISION_TIMEOUT=60
# Optional Research backend: direct (default) or mcp.
ROVA_RESEARCH_BACKEND=direct
# ROVA_RESEARCH_MCP_URL=https://mcp.tavily.com/mcp/
# TAVILY_API_KEY=your-tavily-api-key
